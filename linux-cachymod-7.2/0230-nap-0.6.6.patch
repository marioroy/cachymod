+#include "nap_nn_gh.h"
+
+static void NAP_SYM(learn)(struct nap_cpu *d, float lr)
+{
+	vf g[OV], gh[HV];
+	int i, j, k;
+
+	for (k = 0; k < OV; k++)
+		g[k] = ld(&d->g[k * NAP_VL]);
+	NAP_SYM(gh)(d, g);
+	for (k = 0; k < HV; k++)
+		gh[k] = ld(&d->gh[k * NAP_VL]);
+
+	/* output layer, then bias */
+	for (j = 0; j < NAP_NHID; j++) {
+		vf c = bc(lr * d->hid[j]);
+
+		for (k = 0; k < OV; k++)
+			st(&d->w2r[j][k * NAP_VL],
+			   ld(&d->w2r[j][k * NAP_VL]) - c * g[k]);
+	}
+	for (k = 0; k < OV; k++)
+		st(&d->b2[k * NAP_VL],
+		   ld(&d->b2[k * NAP_VL]) - bc(lr) * g[k]);
