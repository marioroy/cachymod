
Lift the THP restriction with the CachyMod RT kernel.

> Users get the best of both worlds—uncompromised real-time
> predictability by default, but the raw speed of Huge Pages
> whenever an application explicitly asks for it via madvise.
>     - Google/Gemini, 2026

Signed-off-by: Mario Roy <>


diff -uarp a/mm/Kconfig b/mm/Kconfig
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -845,7 +845,7 @@ config MM_ID
 
 menuconfig TRANSPARENT_HUGEPAGE
 	bool "Transparent Hugepage Support"
-	depends on HAVE_ARCH_TRANSPARENT_HUGEPAGE && !PREEMPT_RT
+	depends on HAVE_ARCH_TRANSPARENT_HUGEPAGE
 	select COMPACTION
 	select XARRAY_MULTI
 	select MM_ID
@@ -863,7 +863,8 @@ if TRANSPARENT_HUGEPAGE
 
 choice
 	prompt "Transparent Hugepage Support sysfs defaults"
-	default TRANSPARENT_HUGEPAGE_ALWAYS
+	default TRANSPARENT_HUGEPAGE_MADVISE if PREEMPT_RT
+	default TRANSPARENT_HUGEPAGE_ALWAYS if !PREEMPT_RT
 	help
 	  Selects the sysfs defaults for Transparent Hugepage Support.
 
-- 
2.55.0

